# Thomson Reuters Azure OpenAI Configuration
# Copy this file to .env and update with your actual values

# Thomson Reuters OpenAI Workspace Configuration
REACT_APP_TR_WORKSPACE_ID=your_workspace_id_here
REACT_APP_TR_MODEL_NAME=gpt-4o
REACT_APP_TR_ASSET_ID=your_asset_id_here

# Optional: Override default URLs (usually not needed)
# REACT_APP_TR_BASE_URL=https://eais2-use.int.thomsonreuters.com
# REACT_APP_TR_TOKEN_URL=https://aiplatform.gcs.int.thomsonreuters.com/v1/openai/token
