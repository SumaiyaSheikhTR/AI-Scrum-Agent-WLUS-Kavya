                              color: '#17a2b8', 
                              fontWeight: 600,
                              fontSize: '0.7rem',
                              opacity: 0.6
                            }}
                          />
                        )}
                        */}
                      </Box>

                      {/* Hidden Child Tasks Metrics section
                      <Box sx={{ p: 2, backgroundColor: '#ffe0b2', borderRadius: 1, mb: 2 }}>
                        <Typography variant="caption" sx={{ fontWeight: 'bold', display: 'block', mb: 1 }}>
                          📋 Child Tasks ({p2Metrics.totalTasks})
                        </Typography>
                        <Box sx={{ display: 'flex', flexDirection: 'column', gap: 0.3 }}>
                          <Typography variant="caption" color="text.secondary">
                            ✅ Completed: {p2Metrics.completedTasks}
                          </Typography>
                          <Typography variant="caption" color="text.secondary">
                            🔄 In Progress: {p2Metrics.inProgressTasks}
                          </Typography>
                          <Typography variant="caption" color="text.secondary">
                            ⏳ Pending: {p2Metrics.pendingTasks}
                          </Typography>
                          <Typography variant="caption" color="text.secondary">
                            🚫 Blocked: {p2Metrics.blockedTasks}
                          </Typography>
                        </Box>
                      </Box>
                      */}

                      {/* URLs Section */}
                      <Box sx={{ display: 'flex', gap: 1, mb: 1 }}>
                        {p2Metrics.adoUrls && p2Metrics.adoUrls.length > 0 ? (
                          <Button
                            href={p2Metrics.adoUrls[0]}
                            target="_blank"
                            size="small"
                            variant="outlined"
