                            '0%': { opacity: 1 },
                            '50%': { opacity: 0.7 },
                            '100%': { opacity: 1 }
                          }
                        }}
                      />
                    )}
                  </Box>
                  <Typography variant="body2" color="text.secondary" sx={{ mb: 1 }}>
                    Assigned to: {item.assignedTo || 'Unassigned'}
                  </Typography>
                  <Box sx={{ mt: 1, display: 'flex', justifyContent: 'space-between', alignItems: 'center' }}>
                    <Box sx={{ display: 'flex', alignItems: 'center', gap: 1 }}>
                      <Typography variant="caption" color="text.secondary">
                        Click for details
                      </Typography>
                      {getPRLinks(item).length > 0 && (
                        <Chip 
                          icon={<GitHubIcon sx={{ fontSize: 12 }} />}
                          label={`${getPRLinks(item).length} PR${getPRLinks(item).length > 1 ? 's' : ''}`}
                          size="small"
                          sx={{
                            backgroundColor: '#28a745',
                            color: 'white',
                            fontSize: '0.7rem',
                            height: 18,
                            '& .MuiChip-icon': {
                              color: 'white'
                            }
                          }}
                        />
                      )}
                    </Box>
                    <OpenInNewIcon sx={{ fontSize: 16, color: 'text.secondary' }} />
                  </Box>
                </Paper>
              ))}
              {workItems
                .filter(item => item.type === 'Task')
                .sort((a, b) => (a.priority || 999) - (b.priority || 999)) // Sort by priority: P1, P2, P3, etc.
                .length === 0 && (
                <Alert severity="info">
                  No Tasks found in the current sprint.
                </Alert>
              )}
            </Box>
          </Item>
        </Grid>
        */}

        {/* Hidden Sprint Capacity Utilization
        <Grid item xs={12} md={4}>
          <Item>
            <Typography variant="h5" component="h2" gutterBottom>
              Sprint Capacity Utilization
            </Typography>
