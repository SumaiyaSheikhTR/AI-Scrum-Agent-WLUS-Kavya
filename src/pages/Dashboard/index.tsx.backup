                            }}
                          />
                        )}
                        {p2Metrics.userStories > 0 ? (
                          <Chip 
                            label={`📖 ${p2Metrics.userStories} Story${p2Metrics.userStories > 1 ? 's' : ''}`}
                            size="small"
                            sx={{ 
                              backgroundColor: '#17a2b8', 
                              color: 'white', 
