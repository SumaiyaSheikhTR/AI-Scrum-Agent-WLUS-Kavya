        {/* Hidden Developer Engagement Panel
        <Grid item xs={12} md={6}>
          <Item>
            <Box sx={{ height: 'auto', minHeight: 600 }}>
              <DeveloperEngagementPanel />
            </Box>
          </Item>
        </Grid>
        */}

        {/* Hidden AI Scrum Assistant
        <Grid item xs={12} md={6}>
          <Item>
            <Box sx={{ height: 'auto', minHeight: 600 }}>
              <AiScrumAssistant />
            </Box>
          </Item>
        </Grid>
        */}

        {/* Hidden Git PR Monitoring Panel (Work Items with Pull Requests)
        <Grid item xs={12}>
          <Item>
            <Box sx={{ height: 'auto', minHeight: 600 }}>
              <GitPRMonitoringPanel />
            </Box>
          </Item>
        </Grid>
        */}
      </Grid>

      </Box> {/* Close Main Content Box */}

      {/* Work Item Details Dialog */}
      <Dialog
        open={isDialogOpen}
        onClose={handleDialogClose}
        maxWidth="lg"
        fullWidth
        PaperProps={{
          sx: {
            borderRadius: 3,
            maxHeight: '90vh',
            border: '1px solid #e0e0e0',
            boxShadow: '0 8px 32px rgba(0,0,0,0.12)'
          }
        }}
      >
        <DialogTitle sx={{ 
          pb: 2, 
          pt: 3, 
          px: 3,
          background: 'linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%)',
          borderBottom: '1px solid #e0e0e0'
        }}>
          <Box sx={{ display: 'flex', justifyContent: 'space-between', alignItems: 'flex-start' }}>
            <Box sx={{ flex: 1, pr: 2 }}>
              <Typography variant="h5" component="h2" sx={{ 
                fontWeight: 700, 
                mb: 2,
                color: '#1a1a1a',
                lineHeight: 1.3
              }}>
                {selectedWorkItem?.title || 'Work Item Details'}
              </Typography>
              <Box sx={{ display: 'flex', gap: 1.5, flexWrap: 'wrap' }}>
                <Chip 
                  label={selectedWorkItem?.type || 'Unknown'} 
                  sx={{ 
                    backgroundColor: '#1976d2',
                    color: 'white',
                    fontWeight: 600,
                    fontSize: '0.875rem'
                  }}
                />
                <Chip 
                  label={`ID: ${selectedWorkItem?.id}`} 
                  variant="outlined" 
                  sx={{ 
                    borderColor: '#1976d2',
                    color: '#1976d2',
                    fontWeight: 600
                  }}
                />
                <Chip 
                  label={selectedWorkItem?.state || 'Unknown'} 
                  sx={{
                    backgroundColor: selectedWorkItem?.state === 'Done' ? '#4caf50' : 
                                   selectedWorkItem?.state === 'Active' ? '#ff9800' : '#9e9e9e',
                    color: 'white',
                    fontWeight: 600
                  }}
                />
                {selectedWorkItem?.priority && (
                  <Chip 
                    label={`Priority ${selectedWorkItem.priority}`} 
                    sx={{
                      backgroundColor: selectedWorkItem.priority === 1 ? '#f44336' : 
                                     selectedWorkItem.priority === 2 ? '#ff9800' : '#2196f3',
                      color: 'white',
                      fontWeight: 600
                    }}
                  />
                )}
              </Box>
            </Box>
            <IconButton 
              onClick={handleDialogClose} 
              sx={{ 
                backgroundColor: 'rgba(255,255,255,0.9)',
                '&:hover': { backgroundColor: 'rgba(255,255,255,1)' },
                boxShadow: 1
              }}
            >
              <CloseIcon />
            </IconButton>
          </Box>
        </DialogTitle>
        
        <DialogContent sx={{ p: 0, backgroundColor: '#fafafa' }}>
          {selectedWorkItem && (
            <Box sx={{ p: 3 }}>
              <Grid container spacing={3}>
                {/* Left Column - Main Content */}
                <Grid item xs={12} md={8}>
                  {/* Description Card */}
                  <Paper 
                    elevation={0} 
                    sx={{ 
                      p: 3, 
                      mb: 3, 
                      borderRadius: 3,
                      border: '1px solid #e3f2fd',
                      backgroundColor: 'white',
                      boxShadow: '0 2px 8px rgba(0,0,0,0.06)'
                    }}
                  >
                    <Box sx={{ display: 'flex', alignItems: 'center', mb: 2 }}>
                      <Box sx={{ 
                        width: 32, 
                        height: 32, 
                        borderRadius: '50%', 
                        backgroundColor: '#e3f2fd',
                        display: 'flex',
                        alignItems: 'center',
                        justifyContent: 'center',
                        mr: 2
                      }}>
                        📋
                      </Box>
                      <Typography variant="h6" sx={{ fontWeight: 700, color: '#1565c0' }}>
                        Description
                      </Typography>
                    </Box>
                    <Box sx={{ 
                      p: 2.5, 
                      backgroundColor: '#f8f9fa', 
                      borderRadius: 2,
                      border: '1px solid #e9ecef'
                    }}>
                      <Typography variant="body1" sx={{ 
                        whiteSpace: 'pre-wrap', 
                        lineHeight: 1.7,
                        color: '#2c2c2c',
                        fontSize: '0.95rem'
                      }}>
                        {formatDescription(selectedWorkItem.description)}
                      </Typography>
                    </Box>
                  </Paper>

                  {/* Git PR Links Card */}
                  {(() => {
                    const prLinks = getPRLinks(selectedWorkItem);
                    return prLinks.length > 0 && (
                      <Paper 
                        elevation={0} 
                        sx={{ 
                          p: 3, 
                          mb: 3, 
                          borderRadius: 3,
                          border: '1px solid #e8f5e9',
                          backgroundColor: 'white',
                          boxShadow: '0 2px 8px rgba(0,0,0,0.06)'
                        }}
                      >
                        <Box sx={{ display: 'flex', alignItems: 'center', mb: 2 }}>
                          <Box sx={{ 
                            width: 32, 
                            height: 32, 
                            borderRadius: '50%', 
                            backgroundColor: '#e8f5e9',
                            display: 'flex',
                            alignItems: 'center',
                            justifyContent: 'center',
                            mr: 2
                          }}>
                            🔗
                          </Box>
                          <Typography variant="h6" sx={{ fontWeight: 700, color: '#2e7d32' }}>
                            Related Pull Requests
                          </Typography>
                        </Box>
                        <Box sx={{ display: 'flex', flexDirection: 'column', gap: 1.5 }}>
                          {prLinks.map((prLink, index) => (
                            <Button
                              key={index}
                              href={prLink}
                              target="_blank"
                              rel="noopener noreferrer"
                              variant="outlined"
                              startIcon={<GitHubIcon />}
                              sx={{ 
                                justifyContent: 'flex-start',
                                borderRadius: 2,
                                borderColor: '#e0e0e0',
                                color: '#1976d2',
                                '&:hover': {
                                  borderColor: '#1976d2',
                                  backgroundColor: '#f5f5f5'
                                }
                              }}
                            >
                              Pull Request #{index + 1}
                            </Button>
                          ))}
                        </Box>
                      </Paper>
                    );
                  })()}

                  {/* Tags Card */}
                  {selectedWorkItem.tags && selectedWorkItem.tags.length > 0 && (
                    <Paper 
                      elevation={0} 
                      sx={{ 
                        p: 3, 
                        borderRadius: 3,
                        border: '1px solid #fff3e0',
                        backgroundColor: 'white',
                        boxShadow: '0 2px 8px rgba(0,0,0,0.06)'
                      }}
                    >
                      <Box sx={{ display: 'flex', alignItems: 'center', mb: 2 }}>
                        <Box sx={{ 
                          width: 32, 
                          height: 32, 
                          borderRadius: '50%', 
                          backgroundColor: '#fff3e0',
                          display: 'flex',
                          alignItems: 'center',
                          justifyContent: 'center',
                          mr: 2
                        }}>
                          🏷️
                        </Box>
                        <Typography variant="h6" sx={{ fontWeight: 700, color: '#f57c00' }}>
                          Tags
                        </Typography>
                      </Box>
                      <Box sx={{ display: 'flex', flexWrap: 'wrap', gap: 1 }}>
                        {selectedWorkItem.tags.map((tag, index) => (
                          <Chip
                            key={index}
                            label={tag}
                            variant="outlined"
                            sx={{
                              borderColor: '#ff9800',
                              color: '#f57c00',
                              backgroundColor: '#fff8e1',
                              fontWeight: 500,
                              '&:hover': {
                                backgroundColor: '#ffecb3'
                              }
                            }}
                          />
                        ))}
                      </Box>
                    </Paper>
                  )}
                </Grid>

                {/* Right Column - Metadata & Actions */}
                <Grid item xs={12} md={4}>
                  {/* Work Item Details Card */}
                  <Paper 
                    elevation={0} 
                    sx={{ 
                      p: 3, 
                      mb: 3, 
                      borderRadius: 3,
                      border: '1px solid #e3f2fd',
                      backgroundColor: 'white',
                      boxShadow: '0 2px 8px rgba(0,0,0,0.06)'
                    }}
                  >
                    <Box sx={{ display: 'flex', alignItems: 'center', mb: 2 }}>
                      <Box sx={{ 
                        width: 32, 
                        height: 32, 
                        borderRadius: '50%', 
                        backgroundColor: '#e3f2fd',
                        display: 'flex',
                        alignItems: 'center',
                        justifyContent: 'center',
                        mr: 2
                      }}>
                        ℹ️
                      </Box>
                      <Typography variant="h6" sx={{ fontWeight: 700, color: '#1565c0' }}>
                        Details
                      </Typography>
                    </Box>
                    <Box sx={{ display: 'flex', flexDirection: 'column', gap: 2 }}>
                      <Box sx={{ 
                        p: 2, 
                        backgroundColor: '#f8f9fa', 
                        borderRadius: 2,
                        border: '1px solid #e9ecef'
                      }}>
                        <Typography variant="caption" sx={{ 
                          fontWeight: 700, 
                          color: '#6c757d',
                          letterSpacing: 0.5,
                          textTransform: 'uppercase'
                        }}>
                          Assigned to
                        </Typography>
                        <Typography variant="body2" sx={{ mt: 0.5, fontWeight: 500 }}>
                          {selectedWorkItem.assignedTo || 'Unassigned'}
                        </Typography>
                      </Box>
                      
                      <Box sx={{ 
                        p: 2, 
                        backgroundColor: '#f8f9fa', 
                        borderRadius: 2,
                        border: '1px solid #e9ecef'
                      }}>
                        <Typography variant="caption" sx={{ 
                          fontWeight: 700, 
                          color: '#6c757d',
                          letterSpacing: 0.5,
                          textTransform: 'uppercase'
                        }}>
                          Effort Points
                        </Typography>
                        <Typography variant="body2" sx={{ mt: 0.5, fontWeight: 500 }}>
                          {selectedWorkItem.effort || 'Not estimated'} points
                        </Typography>
                      </Box>

                      <Box sx={{ 
                        p: 2, 
                        backgroundColor: '#f8f9fa', 
                        borderRadius: 2,
                        border: '1px solid #e9ecef'
                      }}>
                        <Typography variant="caption" sx={{ 
                          fontWeight: 700, 
                          color: '#6c757d',
                          letterSpacing: 0.5,
                          textTransform: 'uppercase'
                        }}>
                          Created
                        </Typography>
                        <Typography variant="body2" sx={{ mt: 0.5, fontWeight: 500 }}>
                          {new Date(selectedWorkItem.createdDate).toLocaleDateString()}
                        </Typography>
                      </Box>

                      <Box sx={{ 
                        p: 2, 
                        backgroundColor: '#f8f9fa', 
                        borderRadius: 2,
                        border: '1px solid #e9ecef'
                      }}>
                        <Typography variant="caption" sx={{ 
                          fontWeight: 700, 
                          color: '#6c757d',
                          letterSpacing: 0.5,
                          textTransform: 'uppercase'
                        }}>
                          Last Updated
                        </Typography>
                        <Typography variant="body2" sx={{ mt: 0.5, fontWeight: 500 }}>
                          {new Date(selectedWorkItem.updatedDate).toLocaleDateString()}
                        </Typography>
                      </Box>
                    </Box>
                  </Paper>

                  {/* ADO Link Card */}
                  <Paper 
                    elevation={0} 
                    sx={{ 
                      p: 3, 
                      borderRadius: 3,
                      border: '1px solid #e8f5e9',
                      backgroundColor: 'white',
                      boxShadow: '0 2px 8px rgba(0,0,0,0.06)'
                    }}
                  >
                    <Box sx={{ display: 'flex', alignItems: 'center', mb: 2 }}>
                      <Box sx={{ 
                        width: 32, 
                        height: 32, 
                        borderRadius: '50%', 
                        backgroundColor: '#e8f5e9',
                        display: 'flex',
                        alignItems: 'center',
                        justifyContent: 'center',
                        mr: 2
                      }}>
                        🔗
                      </Box>
                      <Typography variant="h6" sx={{ fontWeight: 700, color: '#2e7d32' }}>
                        Azure DevOps
                      </Typography>
                    </Box>
                    <Button
                      href={getAdoWorkItemUrl(selectedWorkItem)}
                      target="_blank"
                      rel="noopener noreferrer"
                      variant="contained"
                      fullWidth
                      startIcon={<OpenInNewIcon />}
                      sx={{ 
                        mb: 1.5,
                        borderRadius: 2,
                        textTransform: 'none',
                        fontWeight: 600,
                        boxShadow: '0 4px 12px rgba(25, 118, 210, 0.3)',
                        '&:hover': {
                          boxShadow: '0 6px 16px rgba(25, 118, 210, 0.4)'
                        }
                      }}
                    >
                      Open in ADO Board
                    </Button>
                    <Typography variant="caption" sx={{ 
                      display: 'block', 
                      textAlign: 'center',
                      color: '#6c757d',
                      fontWeight: 500
                    }}>
                      Work Item ID: {selectedWorkItem.id}
                    </Typography>
                  </Paper>
                </Grid>
              </Grid>
            </Box>
          )}
        </DialogContent>
        
        <DialogActions sx={{ 
          p: 3, 
          gap: 1.5,
          backgroundColor: 'white',
          borderTop: '1px solid #e0e0e0'
        }}>
          <Button 
            onClick={handleDialogClose} 
            variant="outlined" 
            sx={{ 
              borderRadius: 2,
              textTransform: 'none',
              fontWeight: 600,
              minWidth: 100
            }}
          >
            Close
          </Button>
          {selectedWorkItem && (
            <Button
              onClick={() => window.open(getAdoWorkItemUrl(selectedWorkItem), '_blank')}
              variant="contained"
              startIcon={<OpenInNewIcon />}
              sx={{ 
                borderRadius: 2,
                textTransform: 'none',
                fontWeight: 600,
                boxShadow: '0 4px 12px rgba(25, 118, 210, 0.3)',
                '&:hover': {
                  boxShadow: '0 6px 16px rgba(25, 118, 210, 0.4)'
                }
              }}
            >
              Open in Azure DevOps
            </Button>
          )}
        </DialogActions>
      </Dialog>

      {/* Group Items Dialog */}
      <Dialog
        open={isGroupDialogOpen}
        onClose={handleGroupDialogClose}
        maxWidth="lg"
        fullWidth
        PaperProps={{
          sx: {
            borderRadius: 3,
            maxHeight: '90vh',
            border: '1px solid #e0e0e0',
            boxShadow: '0 8px 32px rgba(0,0,0,0.12)'
          }
        }}
      >
        <DialogTitle sx={{ 
          pb: 2, 
          pt: 3, 
          px: 3,
          background: 'linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%)',
          borderBottom: '1px solid #e0e0e0'
        }}>
          <Box sx={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center' }}>
            <Typography variant="h5" component="h2" sx={{ 
              fontWeight: 700, 
              color: '#1a1a1a',
              lineHeight: 1.3
            }}>
              {groupDialogTitle} ({groupDialogItems.length} items)
            </Typography>
            <IconButton 
              onClick={handleGroupDialogClose} 
              sx={{ 
                backgroundColor: 'rgba(255,255,255,0.9)',
                '&:hover': { backgroundColor: 'rgba(255,255,255,1)' },
                boxShadow: 1
              }}
            >
              <CloseIcon />
            </IconButton>
          </Box>
        </DialogTitle>
        
        <DialogContent sx={{ p: 0, backgroundColor: '#fafafa' }}>
          <Box sx={{ p: 3 }}>
            {groupDialogItems.length > 0 ? (
              <Grid container spacing={2}>
                {groupDialogItems
                  .sort((a, b) => (a.priority || 999) - (b.priority || 999))
                  .map((item) => (
                  <Grid item xs={12} md={6} key={item.id}>
                    <Paper 
                      elevation={0} 
                      sx={{ 
                        p: 3, 
                        backgroundColor: 'white',
                        borderRadius: 2,
                        border: '1px solid #e0e0e0',
                        borderLeft: `4px solid ${item.priority === 1 ? '#f44336' : item.priority === 2 ? '#ff9800' : '#4caf50'}`,
                        cursor: 'pointer',
                        '&:hover': {
                          backgroundColor: '#f8f9fa',
                          transform: 'translateY(-1px)',
                          boxShadow: 2,
                        },
                        transition: 'all 0.2s ease-in-out'
                      }}
                      onClick={() => {
                        setSelectedWorkItem(item);
                        setIsDialogOpen(true);
                        setIsGroupDialogOpen(false);
                      }}
                    >
                      <Box sx={{ display: 'flex', justifyContent: 'space-between', alignItems: 'flex-start', mb: 2 }}>
                        <Typography variant="h6" sx={{ fontWeight: 'bold', flex: 1, pr: 2 }}>
                          {item.title}
                        </Typography>
                        <Chip 
                          label={`P${item.priority || '?'}`} 
                          size="small"
                          sx={{
                            backgroundColor: item.priority === 1 ? '#f44336' : 
                                           item.priority === 2 ? '#ff9800' : 
                                           item.priority === 3 ? '#2196f3' : '#9e9e9e',
                            color: 'white',
                            fontWeight: 600,
                            fontSize: '0.75rem',
                            height: 20
                          }}
                        />
                      </Box>
                      
                      <Box sx={{ display: 'flex', gap: 1, mb: 2, flexWrap: 'wrap' }}>
                        <Chip 
                          label={item.type} 
                          size="small"
                          sx={{ 
                            backgroundColor: item.type === 'Bug' ? '#dc3545' : 
                                           item.type === 'User Story' ? '#17a2b8' : '#1976d2',
                            color: 'white',
                            fontWeight: 600
                          }}
                        />
                        <Chip 
                          label={`ID: ${item.id}`} 
                          size="small"
                          variant="outlined" 
                          sx={{ 
                            borderColor: '#1976d2',
                            color: '#1976d2',
                            fontWeight: 600
                          }}
                        />
                        <Chip 
                          label={item.state} 
                          size="small"
                          sx={{
                            backgroundColor: item.state === 'Done' ? '#4caf50' : 
                                           item.state === 'Active' ? '#ff9800' : 
                                           item.state === 'Blocked' ? '#f44336' : '#9e9e9e',
                            color: 'white',
                            fontWeight: 600
                          }}
                        />
                      </Box>

                      <Typography variant="body2" color="text.secondary" sx={{ mb: 2 }}>
                        Assigned to: {item.assignedTo || 'Unassigned'}
                      </Typography>

                      <Box sx={{ 
                        p: 2, 
                        backgroundColor: '#f8f9fa', 
                        borderRadius: 1,
                        border: '1px solid #e9ecef',
                        mb: 2
                      }}>
                        <Typography variant="body2" sx={{ 
                          display: '-webkit-box',
                          WebkitLineClamp: 3,
                          WebkitBoxOrient: 'vertical',
                          overflow: 'hidden',
                          textOverflow: 'ellipsis',
                          lineHeight: 1.5
                        }}>
                          {formatDescription(item.description)}
                        </Typography>
                      </Box>

                      <Box sx={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center' }}>
                        <Box sx={{ display: 'flex', gap: 1 }}>
                          <Button
                            href={getAdoWorkItemUrl(item)}
                            target="_blank"
                            rel="noopener noreferrer"
                            variant="outlined"
                            size="small"
                            startIcon={<OpenInNewIcon />}
                            sx={{ 
                              textTransform: 'none',
                              fontWeight: 600,
                              borderRadius: 1
                            }}
                          >
                            ADO
                          </Button>
                          {getPRLinks(item).length > 0 && (
                            <Button
                              href={getPRLinks(item)[0]}
                              target="_blank"
                              rel="noopener noreferrer"
                              variant="contained"
                              size="small"
                              startIcon={<GitHubIcon />}
                              sx={{ 
                                textTransform: 'none',
                                fontWeight: 600,
                                borderRadius: 1,
                                backgroundColor: '#28a745',
                                '&:hover': {
                                  backgroundColor: '#1e7e34'
                                }
                              }}
                            >
                              PR ({getPRLinks(item).length})
                            </Button>
                          )}
                        </Box>
                        <Typography variant="caption" color="text.secondary">
                          Click card for full details
                        </Typography>
                      </Box>
                    </Paper>
                  </Grid>
                ))}
              </Grid>
            ) : (
              <Alert severity="info" sx={{ mt: 2 }}>
                No work items found in this category.
              </Alert>
            )}
          </Box>
        </DialogContent>
        
        <DialogActions sx={{ 
          p: 3, 
          backgroundColor: 'white',
          borderTop: '1px solid #e0e0e0'
        }}>
          <Button 
            onClick={handleGroupDialogClose} 
            variant="outlined" 
            sx={{ 
              borderRadius: 2,
              textTransform: 'none',
              fontWeight: 600
            }}
          >
            Close
          </Button>
        </DialogActions>
      </Dialog>
      
    </Box>
  );
};

export default Dashboard;
